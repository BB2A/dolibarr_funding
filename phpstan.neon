parameters:
    level: 0

    # Bootstrap that defines Dolibarr constants without loading main.inc.php
    # (the core is scanned, not executed).
    bootstrap: dev/build/phpstan/bootstrap.php

    # Only analyse the module files (not the cloned Dolibarr core).
    paths:
        - class
        - core
        - fundingindex.php

    # The Dolibarr core is provided by the CI (cloned into dolibarr_core/htdocs)
    # so PHPStan can discover base classes (CommonObject, Form, User, ...) without
    # executing main.inc.php (which would require a full Dolibarr install).
    scanDirectories:
        - dolibarr_core/htdocs

    excludePaths:
        - dolibarr_core/*

    memoryLimit: 2G

    # Do not fail on unmatched ignored errors (baseline tolerance).
    reportUnmatchedIgnoredErrors: false
