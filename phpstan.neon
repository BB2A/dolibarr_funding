parameters:
    level: 0

    # Bootstrap that defines Dolibarr constants without loading main.inc.php
    # (the core is scanned, not executed).
    bootstrapFiles:
        - dev/build/phpstan/bootstrap.php

    # Only analyse the module files (not the cloned Dolibarr core).
    paths:
        - class
        - core
        - fundingindex.php

    # Scan the Dolibarr core so PHPStan can discover the base classes
    # (CommonObject, Form, User, ...) and the global helper functions.
    scanFiles:
        - dolibarr_core/htdocs/core/lib/functions.lib.php
        - dolibarr_core/htdocs/core/lib/functions2.lib.php
    scanDirectories:
        - dolibarr_core/htdocs

    excludePaths:
        - dolibarr_core/*

    # Baseline that freezes existing errors so only new regressions are
    # reported. Regenerate with: phpstan analyse --generate-baseline.
    baseline: phpstan-baseline.neon

    # Do not fail on unmatched ignored errors (baseline tolerance).
    reportUnmatchedIgnoredErrors: false
